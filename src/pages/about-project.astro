---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import CommunitiesList from '../components/CommunitiesList.astro';
import { readFileSync } from 'fs';
import { join } from 'path';

let page: any = { text: '', links: [] };
try {
  page = JSON.parse(readFileSync(join(process.cwd(), 'src/content/pages/about-project.json'), 'utf-8'));
} catch {
  // content not generated yet
}
---

<Layout title="О проекте – ВАСИЛЬЕВСКИЙ ОСТРОВ">
  <Header title="О проекте" layout="project" />
  <section class="about-project padded-wrap">
    <div class="about-project__content" set:html={page.text} />
  </section>
  {page.links?.length > 0 && (
    <div class="about-project-links">
      <h2 class="about-project-links__title padded-wrap">Ссылки</h2>
      <CommunitiesList items={page.links} />
    </div>
  )}
</Layout>
