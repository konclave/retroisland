---
import './about.css';
import './about.d.css';
---

<section class="about">
  <header class="about__header">
    <p class="about__site-title">Васильевский остров</p>
    <p class="about__site-subtitle">Авторский сайт о вокально-инструментальных ансамблях и музыке советской эпохи</p>
  </header>
  <p class="about__disclaimer">
    Песни, представленные на этом сайте, выложены в пониженном битрейте
    и предназначены исключительно для ознакомления с творчеством
    исполнителей. Каждый законопослушный гражданин обязан после
    прослушивания немедленно стереть файл со своего компьютера и срочно
    бежать в магазин для покупки этих песен на легальных носителях (т.е.
    виниловых миньонов и гибких пластинок).
  </p>
  <address class="about__author author">
    <h3 class="author__header">Автор проекта</h3>
    <em class="author__name">Анатолий Васильев</em>
    <ul class="author__link social-links">
      <li class="social-links__item">
        <a class="social-link" href="mailto:noreply@example.com" id="author-email" aria-label="Написать автору по email">
          <svg aria-hidden="true" fill="none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M24 20.488A3.503 3.503 0 0120.506 24H3.494A3.503 3.503 0 010 20.488V3.512A3.503 3.503 0 013.494 0h17.012A3.503 3.503 0 0124 3.512v16.976z" fill="#000"/>
            <path d="M5 10.5v7.313a.562.562 0 00.563.562h12.375a.562.562 0 00.562-.563V10.5L11.75 6 5 10.5zM10.523 14.438l-5.35 3.778M18.326 18.216l-5.35-3.779" stroke="#fff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M18.5 10.5l-5.523 3.938h-2.454L5 10.5" stroke="#fff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </li>
      <li class="social-links__item">
        <a class="social-link" href="https://www.facebook.com/rdddra" aria-label="Профиль автора в Facebook">
          <svg aria-hidden="true" fill="none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M24 20.488A3.503 3.503 0 0120.506 24H3.494A3.503 3.503 0 010 20.488V3.512A3.503 3.503 0 013.494 0h17.012A3.503 3.503 0 0124 3.512v16.976z" fill="#000"/>
            <path d="M24 12c0-6.627-5.373-12-12-12S0 5.373 0 12c0 5.99 4.388 10.954 10.125 11.854V15.47H7.078V12h3.047V9.356c0-3.007 1.791-4.668 4.533-4.668 1.313 0 2.686.234 2.686.234v2.953H15.83c-1.491 0-1.956.925-1.956 1.874V12h3.328l-.532 3.469h-2.796v8.385C19.612 22.954 24 17.99 24 12z" fill="#000"/>
            <path d="M16.673 15.469L17.205 12h-3.328V9.749c0-.949.465-1.874 1.955-1.874h1.514V4.922s-1.374-.234-2.687-.234c-2.74 0-4.532 1.66-4.532 4.668V12H7.08v3.469h3.047v8.385a12.084 12.084 0 003.75 0V15.47h2.796z" fill="#fff"/>
          </svg>
        </a>
      </li>
      <li class="social-links__item">
        <a class="social-link" href="/rss.xml" aria-label="RSS-лента сайта">
          <svg aria-hidden="true" viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg">
            <path d="M384 32H64C28.65 32 0 60.66 0 96v320c0 35.34 28.65 64 64 64h320c35.35 0 64-28.66 64-64V96C448 60.66 419.3 32 384 32zM150.6 374.6C144.4 380.9 136.2 384 128 384s-16.38-3.121-22.63-9.371c-12.5-12.5-12.5-32.76 0-45.26C111.6 323.1 119.8 320 128 320s16.38 3.121 22.63 9.371C163.1 341.9 163.1 362.1 150.6 374.6zM249.6 383.9C249 383.1 248.5 384 247.1 384c-12.53 0-23.09-9.75-23.92-22.44C220.5 306.9 173.1 259.5 118.4 255.9c-13.22-.8438-23.25-12.28-22.39-25.5c.8594-13.25 12.41-22.81 25.52-22.38c77.86 5.062 145.3 72.5 150.4 150.4C272.8 371.7 262.8 383.1 249.6 383.9zM345 383.1C344.7 384 344.3 384 343.1 384c-12.8 0-23.42-10.09-23.97-23C315.6 254.6 225.4 164.4 119 159.1C105.8 159.4 95.47 148.3 96.02 135C96.58 121.8 107.9 111.2 121 112c130.7 5.469 241.5 116.3 246.1 246.1C368.5 372.3 358.3 383.4 345 383.1z"/>
          </svg>
        </a>
      </li>
    </ul>
  </address>
</section>

<script>
  // Reveal real email after a short delay (anti-spam)
  setTimeout(() => {
    const el = document.getElementById('author-email');
    if (el) el.setAttribute('href', 'mailto:rddra@gmail.com');
  }, 250);
</script>
