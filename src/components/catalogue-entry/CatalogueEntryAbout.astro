---
import ContentfulPicture from '../ContentfulPicture.astro';

interface ImageAsset {
  url: string;
  title: string;
}

interface Props {
  title: string;
  description?: string;   // pre-rendered HTML string
  shortDescription?: string;
  images?: ImageAsset[];
  tracksCount?: number;
}

const { title, description, shortDescription, images } = Astro.props;
const longTitle = title.length > 25;
---

<article class="catalogue-item-about padded-wrap">
  <div class="catalogue-item-about__images">
    {images?.map((image) => (
      <ContentfulPicture
        src={image.url}
        title={image.title || title}
        config={[
          { media: 'default', width: 480 },
          { media: '(min-width: 480px)', width: 453 },
        ]}
      />
    ))}
  </div>
  {shortDescription && (
    <h3 class="catalogue-item-about__person-desc">{shortDescription}</h3>
  )}
  <h2 class:list={['catalogue-item-about__name', { 'catalogue-item-about__name_xx-long': longTitle }]}>
    {title}
  </h2>
  {description && (
    <main class="catalogue-item-about__text" set:html={description} />
  )}
</article>
