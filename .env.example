# Contentful credentials — used only by the data extraction scripts, not at runtime.
# Run: npm run content:export && npm run content:transform

# Space ID (found in Contentful → Settings → API keys)
CONTENTFUL_SPACE_ID=

# Content Management API token (found in Contentful → Settings → API keys → Content management tokens)
CONTENTFUL_MANAGEMENT_API_ACCESS_TOKEN=

# Base URL prepended to relative audio/file links in the content (e.g. https://files.example.com)
FILE_STORAGE=

# S3-compatible storage — used by content:transform to upload Contentful images
# Run `npm run yc:s3-init` to populate these from Yandex Cloud automatically.
# Bucket name
S3_BUCKET=
# AWS region (use any value for non-AWS providers like Cloudflare R2)
S3_REGION=auto
# Custom endpoint URL for non-AWS providers (leave empty for AWS S3)
S3_ENDPOINT=
# Path prefix inside the bucket for uploaded images (e.g. images)
S3_PREFIX=images
# Public base URL for the uploaded assets (e.g. https://files.example.com/images)
S3_PUBLIC_URL=
# AWS / provider credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
